{
  "name": "@p5-notebook/root",
  "private": true,
  "version": "0.1.0",
  "description": "A minimal Jupyter Notebook UI for p5.js, powered by JupyterLite",
  "keywords": [
    "jupyter",
    "jupyterlite",
    "jupyterlite-extension"
  ],
  "homepage": "https://github.com/jtpio/p5-notebook",
  "bugs": {
    "url": "https://github.com/jtpio/p5-notebook/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jeremy Tuloup",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jtpio/p5-notebook.git"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:prod": "pnpm -r run build:prod",
    "bump:version": "node scripts/bump-version.mjs",
    "clean": "pnpm -r run clean",
    "develop": "jupyter-builder develop --overwrite .",
    "eslint": "pnpm eslint:check --fix",
    "eslint:check": "eslint . --cache",
    "lint": "pnpm prettier && pnpm eslint",
    "lint:check": "pnpm prettier:check && pnpm eslint:check",
    "prettier": "pnpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.mjs,.css,.json,.md,.yml}\"",
    "prettier:check": "pnpm prettier:base --check",
    "watch": "pnpm -r --parallel run watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jupyter/eslint-plugin": "^1.3.0",
    "@jupyterlab/core-meta": "~4.6.4",
    "css-loader": "^7.1.5",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "style-loader": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "packageManager": "pnpm@10.34.6"
}
