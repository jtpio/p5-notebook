{
  "name": "@p5-notebook/root",
  "private": true,
  "version": "0.1.0",
  "description": "A minimal Jupyter Notebook UI for p5.js, powered by JupyterLite",
  "keywords": [
    "jupyter",
    "jupyterlite",
    "jupyterlite-extension"
  ],
  "homepage": "https://github.com/jtpio/p5-notebook",
  "bugs": {
    "url": "https://github.com/jtpio/p5-notebook/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "Jeremy Tuloup",
    "email": ""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jtpio/p5-notebook.git"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "jlpm workspaces foreach -Avt --no-private run build",
    "build:prod": "jlpm workspaces foreach -Avt --no-private run build:prod",
    "bump:version": "node scripts/bump-version.mjs",
    "clean": "jlpm workspaces foreach -Avt --no-private run clean",
    "develop": "jupyter-builder develop --overwrite .",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint . --cache",
    "lint": "jlpm prettier && jlpm eslint",
    "lint:check": "jlpm prettier:check && jlpm eslint:check",
    "prettier": "jlpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.mjs,.css,.json,.md,.yml}\"",
    "prettier:check": "jlpm prettier:base --check",
    "watch": "jlpm workspaces foreach -Apiv -j unlimited --no-private run watch"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jupyter/eslint-plugin": "^1.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.0.0",
    "prettier": "^3.8.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "packageManager": "yarn@3.5.0"
}
