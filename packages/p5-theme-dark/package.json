{
  "name": "@p5-notebook/p5-theme-dark",
  "version": "0.1.0",
  "description": "A p5.js dark theme for JupyterLab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/jtpio/p5-notebook",
  "bugs": {
    "url": "https://github.com/jtpio/p5-notebook/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Jeremy Tuloup",
  "files": [
    "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
    "style/**/*.{css,eot,gif,html,jpg,json,png,svg,woff2,ttf}"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtpio/p5-notebook.git"
  },
  "scripts": {
    "build": "jlpm run build:lib && jlpm run build:labextension:dev",
    "build:prod": "jlpm run build:lib && jlpm run build:labextension",
    "build:labextension": "jupyter-builder build .",
    "build:labextension:dev": "jupyter-builder build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm run clean:lib && jlpm run clean:labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf ../../p5_notebook/p5-theme-dark",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter-builder watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.6.0",
    "@jupyterlab/apputils": "^4.7.0"
  },
  "devDependencies": {
    "@jupyter/builder": "^1.2.3",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "jupyterlab": {
    "extension": true,
    "themePath": "style/index.css",
    "outputDir": "../../p5_notebook/p5-theme-dark"
  }
}
